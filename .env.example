# Copy this file to .env and fill in the values. .env is gitignored.
# Real environment variables override anything set here.

# --- Target environment ---
BASE_URL=https://demoblaze.com/

# --- Demoblaze account ---
# A pre-existing account, used by scenarios that need a persistent login.
# Most scenarios sign up a fresh account per run and ignore these.
DEMOBLAZE_USERNAME=
DEMOBLAZE_PASSWORD=

# --- Browser / run behaviour ---
HEADLESS=true
SLOW_MO_MS=0
CUCUMBER_STEP_TIMEOUT_MS=30000
CUCUMBER_SCENARIO_LOGS=true

# --- AI failure diagnosis (optional) ---
AI_DEBUG_ALLURE=false
OPENAI_API_KEY=
# AI_DEBUG_MODEL=gpt-4.1-mini
# AI_DEBUG_MAX_FAILURES=5
# OPENAI_BASE_URL=https://api.openai.com/v1
